# AI-DataSeek model provider (OpenAI-compatible)
API_KEY=replace-with-model-api-key
API_BASE=https://api.openai.com/v1
MODEL_PROVIDER=openai
MODEL_NAME=gpt-4o
EXECUTION_MAX_TOKENS=4096
# Model-facing Cordis selection for sessions without an explicit Agent profile.
TOOL_SELECTION_MODE=on_demand
TOOL_PRESET_ID=general
# Restricted sequential tool composition and domain step executors are trials.
CODE_MODE_ENABLED=false
DOMAIN_SUBAGENTS_ENABLED=false
# TEMPERATURE=0.2
# MAX_TOKENS=4000
# Transient LLM failures (408/409/429/5xx) use bounded exponential backoff.
# LLM_CLIENT_MAX_RETRIES=2
# LLM_RETRY_ATTEMPTS=4
# LLM_RETRY_BASE_SECONDS=1
# LLM_RETRY_MAX_SECONDS=8
# Stable random secret for privacy-preserving execution snapshot identities.
# Keep this value unchanged across restarts, upgrades, and backend replicas.
# Existing deployments fall back to API_KEY, but a separate 32+ byte key is recommended.
# EXECUTION_SNAPSHOT_IDENTITY_KEY=
# Tool-free synthesis after the bounded Agent tool budget is exhausted.
# AGENT_FINALIZATION_TIMEOUT_SECONDS=45
# Keep optional dataset question generation below the frontend's 30-second timeout.
# DATASET_SUGGESTED_QUESTION_TIMEOUT_SECONDS=8

# Optional independent vision model for image/raster inspection
# VISION_MODEL_PROVIDER=openai
# VISION_MODEL_BASE=https://api.openai.com/v1
# VISION_MODEL_API_KEY=
# VISION_MODEL_NAME=gpt-4o

# The only supported public frontend port.
FRONTEND_PORT=7000
# Use 127.0.0.1 for a machine-local deployment; public deployments keep 0.0.0.0.
FRONTEND_BIND_HOST=0.0.0.0

# Authentication is disabled. Every request uses one built-in system administrator.
AUTH_PROVIDER=none
SERVER_HOST=http://39.106.98.67:7000

# Database and cache
MONGODB_DATABASE=ai_dataseek
REDIS_DB=0
# MONGODB_IMAGE=mongo:7.0
# REDIS_IMAGE=redis:7.0

# File storage
FILE_STORAGE_PROVIDER=hybrid
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=replace-with-a-strong-minio-secret
MINIO_IMAGE=minio/minio:RELEASE.2025-04-22T22-12-26Z
MINIO_BUCKET=ai-dataseek-files
MINIO_SECURE=false
MINIO_OBJECT_PREFIX=files

# Oversized UTF-8 tool results: save the full body privately and keep only a
# bounded preview/reference in model context, SSE, Redis, and Mongo events.
SPILL_ENABLED=true
# Persist sandbox analysis job lifecycle, status queries, and targeted cancellation.
ANALYSIS_JOBS_ENABLED=true
# Independent Fernet key for the tool credential vault; keep stable and private.
# Missing/invalid key disables credential creation/use, not ordinary analysis.
CREDENTIAL_ENCRYPTION_KEY=

# Phase 6: deployment engineering limits (not user quotas or provider prices).
# Offline estimated request size includes messages, tool schemas and output reserve.
MODEL_CONTEXT_CAPACITY_TOKENS=131072
MODEL_CONTEXT_SAFETY_TOKENS=2048
MODEL_TASK_TOKEN_BUDGET=1000000
MODEL_TASK_CALL_BUDGET=128
MODEL_TRACE_STORE_TIMEOUT_SECONDS=3
SPILL_MAX_INLINE_BYTES=50000
SPILL_MAX_ARTIFACT_BYTES=33554432
SPILL_PREVIEW_BYTES=12000
SPILL_READ_CHUNK_BYTES=16000
SPILL_STORE_TIMEOUT_SECONDS=5
SPILL_ARTIFACT_RETENTION_HOURS=168
SPILL_REAPER_INTERVAL_SECONDS=300
# Stable 32+ byte secret for deterministic opaque spill ids. When blank, the
# execution snapshot key, model API key, then JWT secret are tried in order.
# SPILL_ARTIFACT_IDENTITY_KEY=

# Per-session analysis sandbox
SANDBOX_ISOLATION=session
SANDBOX_IMAGE=ai-dataseek-sandbox:latest
SANDBOX_NAME_PREFIX=ai-dataseek-sandbox
SANDBOX_NETWORK=ai-dataseek-network
SANDBOX_TTL_MINUTES=30
SANDBOX_POOL_SIZE=0
SANDBOX_MAX_CONCURRENT=3
SANDBOX_CAPACITY_WAIT_SECONDS=60
SANDBOX_CAPACITY_POLL_SECONDS=1
SANDBOX_PAUSED_DESTROY_AFTER_MINUTES=30
SANDBOX_RESUME_READY_TIMEOUT_SECONDS=30
SANDBOX_HYDRATION_CONCURRENCY=3

# Dataset directories are validated on the Docker host and mounted read-only.
DATASET_STORAGE_ROOT=/data/datasets
DATASET_MANAGED_VOLUME=ai-dataseek-dataset-data
DATASET_HOST_PATH_ALLOWLIST=/data,/mnt,/srv,/opt/datasets
# Snap Docker only: DATASET_DOCKER_HOST_ROOT=/var/lib/snapd/hostfs
DATASET_DOCKER_HOST_ROOT=

# Plugins
PLUGIN_RUNTIME_ENABLED=true
# Blank paths use plugin-host/dist/index.js and tools/ from this checkout.
# PLUGIN_RUNTIME_NODE_EXECUTABLE=node
# PLUGIN_RUNTIME_HOST_PATH=/opt/ai-dataseek/plugin-host/dist/index.js
# PLUGIN_RUNTIME_TOOLS_DIR=/opt/ai-dataseek/tools
# PLUGIN_RUNTIME_EXECUTION_CONTRACT_DIR=/opt/ai-dataseek/sandbox-contract
# PLUGIN_RUNTIME_REQUEST_TIMEOUT_SECONDS=5
# PLUGIN_RUNTIME_STARTUP_TIMEOUT_SECONDS=15
# PLUGIN_RUNTIME_SHUTDOWN_TIMEOUT_SECONDS=3
# Large catalogs are returned as one NDJSON frame; keep a bounded limit above 64 KiB.
# PLUGIN_RUNTIME_MAX_RESPONSE_FRAME_BYTES=8388608
SKILLS_ENABLED=true
SKILLS_DIR=/app/skills
USER_SKILLS_DIR=/data/skills/users
MAX_ACTIVE_SKILLS=3
# MCP_CONFIG_PATH=/etc/mcp.json

# Search used by the general data-exploration Agent
SEARCH_PROVIDER=bing_web

# Optional SMTP settings for password registration/reset flows
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_USERNAME=
# EMAIL_PASSWORD=
# EMAIL_FROM=

APP_TIMEZONE=Asia/Shanghai
LOG_LEVEL=INFO

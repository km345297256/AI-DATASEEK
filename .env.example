# AI-DataSeek model provider (OpenAI-compatible)
API_KEY=replace-with-model-api-key
API_BASE=https://api.openai.com/v1
MODEL_PROVIDER=openai
MODEL_NAME=gpt-4o
EXECUTION_MAX_TOKENS=4096
# TEMPERATURE=0.2
# MAX_TOKENS=4000
# Transient LLM failures (408/409/429/5xx) use bounded exponential backoff.
# LLM_CLIENT_MAX_RETRIES=2
# LLM_RETRY_ATTEMPTS=4
# LLM_RETRY_BASE_SECONDS=1
# LLM_RETRY_MAX_SECONDS=8
# Tool-free synthesis after the bounded Agent tool budget is exhausted.
# AGENT_FINALIZATION_TIMEOUT_SECONDS=45

# Optional independent vision model for image/raster inspection
# VISION_MODEL_PROVIDER=openai
# VISION_MODEL_BASE=https://api.openai.com/v1
# VISION_MODEL_API_KEY=
# VISION_MODEL_NAME=gpt-4o

# The only supported public frontend port.
FRONTEND_PORT=7000

# Authentication is disabled. Every request uses one built-in system administrator.
AUTH_PROVIDER=none
SERVER_HOST=http://39.106.98.67:7000

# Database and cache
MONGODB_DATABASE=ai_dataseek
REDIS_DB=0
# MONGODB_IMAGE=mongo:7.0
# REDIS_IMAGE=redis:7.0

# File storage
FILE_STORAGE_PROVIDER=hybrid
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=replace-with-a-strong-minio-secret
MINIO_IMAGE=minio/minio:RELEASE.2025-04-22T22-12-26Z
MINIO_BUCKET=ai-dataseek-files
MINIO_SECURE=false
MINIO_OBJECT_PREFIX=files

# Per-session analysis sandbox
SANDBOX_ISOLATION=session
SANDBOX_IMAGE=ai-dataseek-sandbox:latest
SANDBOX_NAME_PREFIX=ai-dataseek-sandbox
SANDBOX_NETWORK=ai-dataseek-network
SANDBOX_TTL_MINUTES=30
SANDBOX_POOL_SIZE=0
SANDBOX_MAX_CONCURRENT=3
SANDBOX_CAPACITY_WAIT_SECONDS=60
SANDBOX_CAPACITY_POLL_SECONDS=1
SANDBOX_PAUSED_DESTROY_AFTER_MINUTES=30
SANDBOX_RESUME_READY_TIMEOUT_SECONDS=30
SANDBOX_HYDRATION_CONCURRENCY=3

# Dataset directories are validated on the Docker host and mounted read-only.
DATASET_STORAGE_ROOT=/data/datasets
DATASET_MANAGED_VOLUME=ai-dataseek-dataset-data
DATASET_HOST_PATH_ALLOWLIST=/data,/mnt,/srv,/opt/datasets
# Snap Docker only: DATASET_DOCKER_HOST_ROOT=/var/lib/snapd/hostfs
DATASET_DOCKER_HOST_ROOT=

# Plugins
SKILLS_ENABLED=true
SKILLS_DIR=/app/skills
USER_SKILLS_DIR=/data/skills/users
MAX_ACTIVE_SKILLS=3
# MCP_CONFIG_PATH=/etc/mcp.json

# Search used by the general data-exploration Agent
SEARCH_PROVIDER=bing_web

# Optional SMTP settings for password registration/reset flows
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_USERNAME=
# EMAIL_PASSWORD=
# EMAIL_FROM=

APP_TIMEZONE=Asia/Shanghai
LOG_LEVEL=INFO

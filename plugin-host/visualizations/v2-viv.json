{
  "contract_version": 2,
  "id": "viz-viv",
  "version": "2.0.0",
  "name": "Viv 多通道显微图像",
  "description": "有界单文件 OME-TIFF 多通道视图；不声明支持目录型 OME-Zarr。",
  "extensions": [
    "ome.tif",
    "ome.tiff"
  ],
  "filenames": [],
  "view_kind": "image",
  "adapter": "v2-viv",
  "data_kind": "extended",
  "reader": "binary",
  "default_enabled": true,
  "priority": 10,
  "permissions": [
    "file:read"
  ],
  "limits": {
    "max_input_bytes": 67108864,
    "max_output_bytes": 8388608
  }
}

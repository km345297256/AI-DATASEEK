{
  "contract_version": 2,
  "id": "markdown",
  "version": "1.0.0",
  "name": "Markdown 文档",
  "description": "Markdown 文档预览",
  "extensions": [
    "md",
    "markdown"
  ],
  "filenames": [],
  "view_kind": "document",
  "adapter": "markdown",
  "reader": "binary",
  "default_enabled": true,

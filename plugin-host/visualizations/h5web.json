{
  "contract_version": 2,
  "id": "viz-h5web",
  "version": "2.1.0",
  "name": "H5Web 层级与切片",
  "description": "HDF5/NeXus、MATLAB v7.3 内部树与有界数值切片；内容识别，不支持经典 NetCDF3。",
  "extensions": [
    "h5",
    "hdf5",
    "nxs",
    "nx",
    "nc4",
    "nc",
    "mat"
  ],
  "filenames": [],
  "view_kind": "image",
  "adapter": "h5web",
  "reader": "hdf5",
  "default_enabled": true,
  "priority": 10,
  "permissions": [
    "file:read"
  ],
  "limits": {
    "max_input_bytes": 67108864,
    "max_output_bytes": 8388608
  },
  "capabilities": {
    "operations": [
      "preview",
      "prepare"
    ],
    "input_mode": "whole",
    "shared": false
  }
}

  "adapter": "grib-window",
  "reader": "grib-window",
  "default_enabled": true,
  "priority": 30,
  "permissions": [
    "file:read"
  ],
  "limits": {
    "max_input_bytes": 8388608,
    "max_output_bytes": 2097152
  },
  "capabilities": {
    "operations": [
      "preview"
    ],
    "input_mode": "window",
    "shared": false
  }

{
  "contract_version": 2,
  "id": "viz-pdfjs",
  "version": "2.0.0",
  "name": "PDF.js 文档阅读",
  "description": "本地逐页 PDF 预览、缩放；禁用文档脚本、表单动作和外部资源。",
  "extensions": [
    "pdf"
  ],
  "filenames": [],
  "view_kind": "document",
  "adapter": "v2-pdfjs",
  "data_kind": "extended",
  "reader": "binary",
  "default_enabled": true,
  "priority": 10,
  "permissions": [
    "file:read"
  ],
  "limits": {
    "max_input_bytes": 67108864,
    "max_output_bytes": 8388608
  }
}

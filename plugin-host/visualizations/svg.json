{
  "contract_version": 2,
  "id": "viz-svg",
  "version": "1.0.0",
  "name": "SVG 矢量图",
  "description": "隔离、离线渲染静态 SVG 图表为安全预览，不加载脚本或外部资源；下载保留原始矢量文件。",
  "extensions": ["svg"],

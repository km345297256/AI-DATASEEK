{
  "contract_version": 2,
  "id": "viz-excel",
  "version": "2.0.0",
  "name": "Excel 工作表预览",
  "description": "只读工作表分页、缓存值和公式文本；不重算、不执行宏或外部连接。",
  "extensions": [
    "xlsx",
    "xls"
  ],
  "filenames": [],
  "view_kind": "table",
  "adapter": "excel",
  "reader": "excel",
  "default_enabled": true,
  "priority": 10,
  "permissions": [
    "file:read"
  ],
  "limits": {
    "max_input_bytes": 67108864,
    "max_output_bytes": 8388608
  },
  "capabilities": {
    "operations": [
      "preview"
    ],
    "input_mode": "whole",
    "shared": false
  }
}

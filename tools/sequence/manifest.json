{"plugin":"sequence","version":"1.0.0","handler":"handler.py","tools":[
{"name":"sequence_identify_format","description":"识别 FASTA 或 FASTQ 格式及质量值编码。","scopes":["dataset_fast_path"],"timeout_seconds":60,"parameters":{"type":"object","properties":{"input_path":{"type":"string"}},"required":["input_path"]}},
{"name":"sequence_inspect","description":"探查序列条目数、读长、碱基组成、GC 含量和质量摘要。","scopes":["dataset_fast_path"],"timeout_seconds":90,"parameters":{"type":"object","properties":{"input_path":{"type":"string"}},"required":["input_path"]}},
{"name":"sequence_validate","description":"校验 FASTA/FASTQ 结构、序列字符和质量长度一致性。","scopes":["dataset_fast_path"],"timeout_seconds":90,"parameters":{"type":"object","properties":{"input_path":{"type":"string"}},"required":["input_path"]}},
{"name":"sequence_stats","description":"统计序列数量、长度分布、GC 含量和 N 碱基比例。","scopes":["dataset_fast_path"],"timeout_seconds":90,"parameters":{"type":"object","properties":{"input_path":{"type":"string"}},"required":["input_path"]}},
{"name":"sequence_quality_encoding","description":"识别 FASTQ Phred 质量值编码范围和质量分布。","scopes":["dataset_fast_path"],"timeout_seconds":60,"parameters":{"type":"object","properties":{"input_path":{"type":"string"}},"required":["input_path"]}},
{"name":"sequence_position_quality","description":"统计 FASTQ 每个位点的平均质量、四分位数和低质量比例。","scopes":["dataset_fast_path"],"timeout_seconds":120,"parameters":{"type":"object","properties":{"input_path":{"type":"string"}},"required":["input_path"]}},
{"name":"sequence_position_bases","description":"统计每个位点 A/C/G/T/N 碱基组成。","scopes":["dataset_fast_path"],"timeout_seconds":120,"parameters":{"type":"object","properties":{"input_path":{"type":"string"}},"required":["input_path"]}},
{"name":"sequence_filter_quality","description":"按平均质量、最小长度和 N 比例过滤 FASTQ 序列。","scopes":["dataset_fast_path"],"timeout_seconds":120,"parameters":{"type":"object","properties":{"input_path":{"type":"string"},"output_path":{"type":"string"},"min_quality":{"type":"number","default":20},"min_length":{"type":"integer","default":30},"max_n_fraction":{"type":"number","default":0.1}},"required":["input_path","output_path"]}},
{"name":"sequence_trim_adapters","description":"按指定接头序列剪切 FASTA/FASTQ 读段。","scopes":["dataset_fast_path"],"timeout_seconds":120,"parameters":{"type":"object","properties":{"input_path":{"type":"string"},"output_path":{"type":"string"},"adapters":{"type":"array","items":{"type":"string"}}},"required":["input_path","output_path","adapters"]}},
{"name":"sequence_trim_length","description":"按两端位置或固定长度裁剪序列。","scopes":["dataset_fast_path"],"timeout_seconds":120,"parameters":{"type":"object","properties":{"input_path":{"type":"string"},"output_path":{"type":"string"},"start":{"type":"integer","default":0},"end":{"type":["integer","null"]}},"required":["input_path","output_path"]}},
{"name":"sequence_deduplicate","description":"按完整序列去除重复读段并统计重复比例。","scopes":["dataset_fast_path"],"timeout_seconds":120,"parameters":{"type":"object","properties":{"input_path":{"type":"string"},"output_path":{"type":"string"}},"required":["input_path","output_path"]}},
{"name":"sequence_pair_validate","description":"检查双端 FASTQ 的读段名称配对和数量一致性。","scopes":["dataset_fast_path"],"timeout_seconds":120,"parameters":{"type":"object","properties":{"read1_path":{"type":"string"},"read2_path":{"type":"string"}},"required":["read1_path","read2_path"]}},
{"name":"sequence_convert_fasta_fastq","description":"在 FASTA 和 FASTQ 格式之间转换序列文件。","scopes":["dataset_fast_path"],"timeout_seconds":120,"parameters":{"type":"object","properties":{"input_path":{"type":"string"},"output_path":{"type":"string"},"default_quality":{"type":"integer","default":40}},"required":["input_path","output_path"]}},
{"name":"sequence_kmer_profile","description":"统计指定 k 值的 k-mer 频率和丰度分布。","scopes":["dataset_fast_path"],"timeout_seconds":120,"parameters":{"type":"object","properties":{"input_path":{"type":"string"},"k":{"type":"integer","default":5}},"required":["input_path"]}},
{"name":"sequence_complexity_check","description":"检测低复杂度、同聚物和重复模式序列。","scopes":["dataset_fast_path"],"timeout_seconds":120,"parameters":{"type":"object","properties":{"input_path":{"type":"string"}},"required":["input_path"]}},
{"name":"sequence_batch_profile","description":"批量生成多个 FASTA/FASTQ 文件的质量画像。","scopes":["dataset_fast_path"],"timeout_seconds":120,"parameters":{"type":"object","properties":{"input_paths":{"type":"array","items":{"type":"string"}}},"required":["input_paths"]}},
{"name":"sequence_fastqc_report","description":"生成 FastQC 风格的质量统计 JSON 和 PNG 报告。","scopes":["dataset_fast_path"],"timeout_seconds":120,"parameters":{"type":"object","properties":{"input_path":{"type":"string"},"output_dir":{"type":"string"}},"required":["input_path","output_dir"]}},
{"name":"reference_fasta_inspect","description":"探查参考 FASTA 的序列名称、长度和碱基组成。","scopes":["dataset_fast_path"],"timeout_seconds":90,"parameters":{"type":"object","properties":{"input_path":{"type":"string"}} ,"required":["input_path"]}},
{"name":"sequence_extract_bed","description":"按 BED 区间从参考 FASTA 提取序列。","scopes":["dataset_fast_path"],"timeout_seconds":120,"parameters":{"type":"object","properties":{"fasta_path":{"type":"string"},"bed_path":{"type":"string"},"output_path":{"type":"string"}},"required":["fasta_path","bed_path","output_path"]}},
{"name":"sequence_alignment_summary","description":"从比对结果摘要文件统计比对率和未比对读段。","scopes":["dataset_fast_path"],"timeout_seconds":90,"parameters":{"type":"object","properties":{"input_path":{"type":"string"}},"required":["input_path"]}},
{"name":"sequence_coverage_profile","description":"根据覆盖度表统计平均深度、覆盖比例和深度分布。","scopes":["dataset_fast_path"],"timeout_seconds":120,"parameters":{"type":"object","properties":{"input_path":{"type":"string"}},"required":["input_path"]}},
{"name":"sequence_depth_visualize","description":"根据覆盖度表生成测序深度曲线 PNG。","scopes":["dataset_fast_path"],"timeout_seconds":120,"parameters":{"type":"object","properties":{"input_path":{"type":"string"},"output_path":{"type":"string"}},"required":["input_path","output_path"]}},
{"name":"sequence_quality_report","description":"生成 FASTA/FASTQ 格式、质量、缺失和异常数据质量报告。","scopes":["dataset_fast_path"],"timeout_seconds":120,"parameters":{"type":"object","properties":{"input_path":{"type":"string"},"output_path":{"type":["string","null"]}},"required":["input_path"]}},
{"name":"sequence_reverse_complement","description":"生成序列的反向互补序列并导出。","scopes":["dataset_fast_path"],"timeout_seconds":120,"parameters":{"type":"object","properties":{"input_path":{"type":"string"},"output_path":{"type":"string"}},"required":["input_path","output_path"]}},
{"name":"sequence_gc_visualize","description":"生成 GC 含量和读长分布可视化图。","scopes":["dataset_fast_path"],"timeout_seconds":120,"parameters":{"type":"object","properties":{"input_path":{"type":"string"},"output_path":{"type":"string"}},"required":["input_path","output_path"]}},
{"name":"sequence_extract_unmapped","description":"从 FASTQ 中按名称清单提取指定读段。","scopes":["dataset_fast_path"],"timeout_seconds":120,"parameters":{"type":"object","properties":{"input_path":{"type":"string"},"names_path":{"type":"string"},"output_path":{"type":"string"}},"required":["input_path","names_path","output_path"]}},
{"name":"blast_result_inspect","description":"探查 BLAST/DIAMOND 标准表格结果并统计命中、相似度、覆盖度和显著性。","scopes":["dataset_fast_path"],"timeout_seconds":90,"parameters":{"type":"object","properties":{"input_path":{"type":"string"}},"required":["input_path"]}},
{"name":"blast_hit_visualize","description":"将 BLAST/DIAMOND 命中结果绘制为查询序列与参考序列的区间连线图。","scopes":["dataset_fast_path"],"timeout_seconds":120,"parameters":{"type":"object","properties":{"input_path":{"type":"string"},"output_path":{"type":"string"},"max_hits":{"type":"integer","default":100}},"required":["input_path","output_path"]}},
{"name":"blast_dotplot_visualize","description":"根据 BLAST 比对坐标生成查询序列与参考序列点阵图。","scopes":["dataset_fast_path"],"timeout_seconds":120,"parameters":{"type":"object","properties":{"input_path":{"type":"string"},"output_path":{"type":"string"}},"required":["input_path","output_path"]}},
{"name":"sequence_quality_boxplot","description":"生成 FASTQ 各测序位置质量值箱线图。","scopes":["dataset_fast_path"],"timeout_seconds":120,"parameters":{"type":"object","properties":{"input_path":{"type":"string"},"output_path":{"type":"string"}},"required":["input_path","output_path"]}},
{"name":"sequence_quality_heatmap","description":"生成 FASTQ 每个位点质量分布热图。","scopes":["dataset_fast_path"],"timeout_seconds":120,"parameters":{"type":"object","properties":{"input_path":{"type":"string"},"output_path":{"type":"string"},"max_reads":{"type":"integer","default":500}},"required":["input_path","output_path"]}},
{"name":"sequence_base_composition_visualize","description":"生成 FASTQ 每个位点碱基组成堆叠图。","scopes":["dataset_fast_path"],"timeout_seconds":120,"parameters":{"type":"object","properties":{"input_path":{"type":"string"},"output_path":{"type":"string"}},"required":["input_path","output_path"]}}
]}

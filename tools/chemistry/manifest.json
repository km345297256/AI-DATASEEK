{
  "plugin": "chemistry",
  "version": "1.1.0",
  "handler": "handler.py",
  "tools": [
    {"name":"cif_inspect","description":"Inspect a CIF crystal structure and report data blocks, cell parameters, space group, chemical formula and atom-site counts.","scopes":["dataset_fast_path"],"timeout_seconds":60,"parameters":{"type":"object","properties":{"input_path":{"type":"string"}},"required":["input_path"],"additionalProperties":false}},
    {"name":"cif_validate_structure","description":"Validate CIF crystal structure completeness, cell parameters, atom coordinates, occupancies and duplicate atom labels.","scopes":["dataset_fast_path"],"timeout_seconds":60,"parameters":{"type":"object","properties":{"input_path":{"type":"string"},"output_path":{"type":["string","null"]}},"required":["input_path"],"additionalProperties":false}},
    {"name":"cif_extract_atoms","description":"Extract CIF atom-site records with labels, element symbols, fractional coordinates, occupancies and isotropic displacement values to CSV or JSON.","scopes":["dataset_fast_path"],"timeout_seconds":60,"parameters":{"type":"object","properties":{"input_path":{"type":"string"},"output_path":{"type":"string"},"format":{"type":"string","enum":["csv","json"],"default":"csv"}},"required":["input_path","output_path"],"additionalProperties":false}},
    {"name":"cif_convert_xyz","description":"Convert CIF atom-site coordinates from fractional to Cartesian coordinates and write an XYZ molecular structure artifact.","scopes":["dataset_fast_path"],"timeout_seconds":90,"parameters":{"type":"object","properties":{"input_path":{"type":"string"},"output_path":{"type":"string"}},"required":["input_path","output_path"],"additionalProperties":false}},
    {"name":"cif_visualize_structure","description":"Render a bounded 3D scatter preview of CIF atom sites, colored by element, and write a PNG artifact.","scopes":["dataset_fast_path"],"timeout_seconds":120,"parameters":{"type":"object","properties":{"input_path":{"type":"string"},"output_path":{"type":"string"},"max_atoms":{"type":"integer","minimum":1,"maximum":10000,"default":2000}},"required":["input_path","output_path"],"additionalProperties":false}}
    ,{"name":"cif_composition_density","description":"计算元素组成、化学式质量、晶胞体积、Z 值和理论密度，并标注计算依据。","scopes":["dataset_fast_path"],"timeout_seconds":60,"parameters":{"type":"object","properties":{"input_path":{"type":"string"},"output_path":{"type":["string","null"]}},"required":["input_path"],"additionalProperties":false}}
    ,{"name":"cif_analyze_geometry","description":"在周期性最小镜像下统计原子邻居、距离和候选近邻对，不推断键级。","scopes":["dataset_fast_path"],"timeout_seconds":90,"parameters":{"type":"object","properties":{"input_path":{"type":"string"},"output_path":{"type":["string","null"]},"cutoff":{"type":"number","minimum":0.1,"maximum":20,"default":3}},"required":["input_path"],"additionalProperties":false}}
    ,{"name":"cif_simulate_pxrd","description":"依据晶胞参数生成有限范围的粉末衍射峰位筛选结果，明确标注为估算结果。","scopes":["dataset_fast_path"],"timeout_seconds":90,"parameters":{"type":"object","properties":{"input_path":{"type":"string"},"output_path":{"type":["string","null"]}},"required":["input_path"],"additionalProperties":false}}
    ,{"name":"cif_compare_structures","description":"比较两个 CIF 的组成、晶胞参数、空间群和原子数，给出可追溯的结构元数据差异。","scopes":["dataset_fast_path"],"timeout_seconds":60,"parameters":{"type":"object","properties":{"input_path":{"type":"string"},"other_path":{"type":"string"}},"required":["input_path","other_path"],"additionalProperties":false}}
    ,{"name":"cif_generate_supercell","description":"按用户指定倍数生成 CIF 超晶胞并输出新的原子分数坐标。","scopes":["dataset_fast_path"],"timeout_seconds":90,"parameters":{"type":"object","properties":{"input_path":{"type":"string"},"output_path":{"type":"string"},"h":{"type":"integer","minimum":1,"maximum":10,"default":1},"k":{"type":"integer","minimum":1,"maximum":10,"default":1},"l":{"type":"integer","minimum":1,"maximum":10,"default":1}},"required":["input_path","output_path"],"additionalProperties":false}}
    ,{"name":"cif_standardize_report","description":"生成 CIF 结构分析报告，汇总数据块、晶胞、组成、密度、空间群、原子统计和质量警告。","scopes":["dataset_fast_path"],"timeout_seconds":90,"parameters":{"type":"object","properties":{"input_path":{"type":"string"},"output_path":{"type":["string","null"]}},"required":["input_path"],"additionalProperties":false}}
    ,{"name":"cif_check_space_group","description":"使用晶体结构坐标识别空间群、晶系和 Hall 符号，并与 CIF 声明空间群进行一致性检查。","scopes":["dataset_fast_path"],"timeout_seconds":90,"parameters":{"type":"object","properties":{"input_path":{"type":"string"},"output_path":{"type":["string","null"]},"symprec":{"type":"number","minimum":0.00001,"maximum":1,"default":0.01},"angle_tolerance":{"type":"number","minimum":0.1,"maximum":20,"default":5}},"required":["input_path"],"additionalProperties":false}}
    ,{"name":"cif_standardize_cell","description":"使用空间群分析生成原始、常规或精修标准晶胞 CIF 数据产品。","scopes":["dataset_fast_path"],"timeout_seconds":120,"parameters":{"type":"object","properties":{"input_path":{"type":"string"},"output_path":{"type":"string"},"convention":{"type":"string","enum":["primitive","conventional","refined"],"default":"conventional"},"symprec":{"type":"number","minimum":0.00001,"maximum":1,"default":0.01}},"required":["input_path","output_path"],"additionalProperties":false}}
    ,{"name":"cif_expand_symmetry","description":"依据识别的晶体对称性精修并展开结构，输出包含完整周期结构的 CIF。","scopes":["dataset_fast_path"],"timeout_seconds":120,"parameters":{"type":"object","properties":{"input_path":{"type":"string"},"output_path":{"type":"string"},"symprec":{"type":"number","minimum":0.00001,"maximum":1,"default":0.01}},"required":["input_path","output_path"],"additionalProperties":false}}
    ,{"name":"cif_coordination_environment","description":"使用周期晶体近邻算法计算每个原子位点的配位数、近邻元素、距离和权重。","scopes":["dataset_fast_path"],"timeout_seconds":120,"parameters":{"type":"object","properties":{"input_path":{"type":"string"},"output_path":{"type":["string","null"]}},"required":["input_path"],"additionalProperties":false}}
    ,{"name":"cif_radial_distribution","description":"计算周期结构的径向分布函数、距离分箱和原子对计数，输出结构化结果。","scopes":["dataset_fast_path"],"timeout_seconds":120,"parameters":{"type":"object","properties":{"input_path":{"type":"string"},"output_path":{"type":["string","null"]},"radius":{"type":"number","minimum":1,"maximum":50,"default":10},"bins":{"type":"integer","minimum":10,"maximum":1000,"default":100}},"required":["input_path"],"additionalProperties":false}}
    ,{"name":"cif_disorder_analysis","description":"识别混合元素、部分占位及占位率和异常的无序位点并保留坐标证据。","scopes":["dataset_fast_path"],"timeout_seconds":90,"parameters":{"type":"object","properties":{"input_path":{"type":"string"},"output_path":{"type":["string","null"]},"tolerance":{"type":"number","minimum":0,"maximum":0.5,"default":0.01}},"required":["input_path"],"additionalProperties":false}}
    ,{"name":"cif_match_structures","description":"在原始晶胞归一化、尺度调整和位点容差下判断两个 CIF 是否为同一晶体结构。","scopes":["dataset_fast_path"],"timeout_seconds":120,"parameters":{"type":"object","properties":{"input_path":{"type":"string"},"other_path":{"type":"string"},"output_path":{"type":["string","null"]},"ltol":{"type":"number","minimum":0.01,"maximum":1,"default":0.2},"stol":{"type":"number","minimum":0.01,"maximum":1,"default":0.3},"angle_tolerance":{"type":"number","minimum":0.1,"maximum":20,"default":5}},"required":["input_path","other_path"],"additionalProperties":false}}
    ,{"name":"cif_calculate_pxrd","description":"基于结构因子计算粉末 X 射线衍射峰位、相对强度、晶面和晶面间距。","scopes":["dataset_fast_path"],"timeout_seconds":120,"parameters":{"type":"object","properties":{"input_path":{"type":"string"},"output_path":{"type":["string","null"]},"wavelength":{"type":"string","default":"CuKa"},"min_angle":{"type":"number","minimum":0,"maximum":180,"default":5},"max_angle":{"type":"number","minimum":0,"maximum":180,"default":90}},"required":["input_path"],"additionalProperties":false}}
    ,{"name":"cif_export_interactive_structure","description":"导出包含晶格矩阵、晶胞参数、原子坐标、元素和占位率的交互式晶体预览数据。","scopes":["dataset_fast_path"],"timeout_seconds":90,"parameters":{"type":"object","properties":{"input_path":{"type":"string"},"output_path":{"type":["string","null"]},"max_atoms":{"type":"integer","minimum":1,"maximum":100000,"default":10000}},"required":["input_path"],"additionalProperties":false}}
  ]
}

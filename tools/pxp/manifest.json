{
  "plugin": "pxp",
  "version": "1.0.0",
  "handler": "handler.py",
  "tools": [
    {"name":"pxp_inspect","description":"探查 Igor Pro PXP 实验容器的版本、目录、wave、变量和总体规模。","scopes":["dataset_fast_path"],"timeout_seconds":60,"parameters":{"type":"object","properties":{"input_path":{"type":"string"}},"required":["input_path"]}},
    {"name":"pxp_validate","description":"校验 PXP 文件头、记录结构、wave 可解析性、坐标标定和数值有效性。","scopes":["dataset_fast_path"],"timeout_seconds":60,"parameters":{"type":"object","properties":{"input_path":{"type":"string"},"output_path":{"type":["string","null"]}},"required":["input_path"]}},
    {"name":"pxp_folder_tree","description":"输出 PXP 内 Igor 数据文件夹、wave 和变量组成的目录树。","scopes":["dataset_fast_path"],"timeout_seconds":60,"parameters":{"type":"object","properties":{"input_path":{"type":"string"},"output_path":{"type":["string","null"]}},"required":["input_path"]}},
    {"name":"pxp_list_waves","description":"列出 PXP 中所有 wave 的路径、形状、类型、单位、坐标范围和点数。","scopes":["dataset_fast_path"],"timeout_seconds":60,"parameters":{"type":"object","properties":{"input_path":{"type":"string"},"output_path":{"type":["string","null"]}},"required":["input_path"]}},
    {"name":"pxp_extract_metadata","description":"提取指定 wave 的名称、注释、单位、维度、创建修改时间和坐标标定。","scopes":["dataset_fast_path"],"timeout_seconds":60,"parameters":{"type":"object","properties":{"input_path":{"type":"string"},"wave_path":{"type":["string","null"]},"wave_index":{"type":"integer","minimum":0,"default":0},"output_path":{"type":["string","null"]}},"required":["input_path"]}},
    {"name":"pxp_extract_wave","description":"提取指定 PXP wave 的坐标与数值，支持多维 wave 的通道选择和点数限制。","scopes":["dataset_fast_path"],"timeout_seconds":90,"parameters":{"type":"object","properties":{"input_path":{"type":"string"},"wave_path":{"type":["string","null"]},"wave_index":{"type":"integer","minimum":0,"default":0},"channel_index":{"type":"integer","minimum":0,"default":0},"max_points":{"type":"integer","minimum":1,"maximum":2000000,"default":200000},"output_path":{"type":["string","null"]}},"required":["input_path"]}},
    {"name":"pxp_export_csv","description":"将指定 PXP wave 连同坐标、单位和数值导出为 CSV 数据产品。","scopes":["dataset_fast_path"],"timeout_seconds":90,"parameters":{"type":"object","properties":{"input_path":{"type":"string"},"wave_path":{"type":["string","null"]},"wave_index":{"type":"integer","minimum":0,"default":0},"channel_index":{"type":"integer","minimum":0,"default":0},"output_path":{"type":"string"}},"required":["input_path","output_path"]}},
    {"name":"pxp_batch_export","description":"将 PXP 中多个数值 wave 批量导出为 CSV，并生成导出清单。","scopes":["dataset_fast_path"],"timeout_seconds":120,"parameters":{"type":"object","properties":{"input_path":{"type":"string"},"output_dir":{"type":"string"},"max_waves":{"type":"integer","minimum":1,"maximum":1000,"default":100}},"required":["input_path","output_dir"]}},
    {"name":"pxp_wave_statistics","description":"计算指定 wave 的有效值、缺失值、极值、均值、标准差和分位数。","scopes":["dataset_fast_path"],"timeout_seconds":90,"parameters":{"type":"object","properties":{"input_path":{"type":"string"},"wave_path":{"type":["string","null"]},"wave_index":{"type":"integer","minimum":0,"default":0},"channel_index":{"type":"integer","minimum":0,"default":0},"output_path":{"type":["string","null"]}},"required":["input_path"]}},
    {"name":"pxp_baseline_correct","description":"使用非对称最小二乘法估计并扣除 PXP 光谱基线。","scopes":["dataset_fast_path"],"timeout_seconds":120,"parameters":{"type":"object","properties":{"input_path":{"type":"string"},"wave_path":{"type":["string","null"]},"wave_index":{"type":"integer","minimum":0,"default":0},"lambda":{"type":"number","minimum":1,"default":100000},"asymmetry":{"type":"number","exclusiveMinimum":0,"exclusiveMaximum":1,"default":0.01},"output_path":{"type":["string","null"]}},"required":["input_path"]}},
    {"name":"pxp_smooth","description":"使用 Savitzky-Golay 方法平滑指定 PXP 光谱序列。","scopes":["dataset_fast_path"],"timeout_seconds":90,"parameters":{"type":"object","properties":{"input_path":{"type":"string"},"wave_path":{"type":["string","null"]},"wave_index":{"type":"integer","minimum":0,"default":0},"window":{"type":"integer","minimum":5,"default":11},"polyorder":{"type":"integer","minimum":1,"default":3},"output_path":{"type":["string","null"]}},"required":["input_path"]}},
    {"name":"pxp_normalize","description":"按最大值、面积或标准分数对指定 PXP 光谱归一化。","scopes":["dataset_fast_path"],"timeout_seconds":90,"parameters":{"type":"object","properties":{"input_path":{"type":"string"},"wave_path":{"type":["string","null"]},"wave_index":{"type":"integer","minimum":0,"default":0},"method":{"type":"string","enum":["max","area","zscore"],"default":"max"},"output_path":{"type":["string","null"]}},"required":["input_path"]}},
    {"name":"pxp_resample","description":"将指定 PXP wave 重采样到用户给定步长的等间隔坐标轴。","scopes":["dataset_fast_path"],"timeout_seconds":90,"parameters":{"type":"object","properties":{"input_path":{"type":"string"},"wave_path":{"type":["string","null"]},"wave_index":{"type":"integer","minimum":0,"default":0},"step":{"type":"number","exclusiveMinimum":0},"output_path":{"type":["string","null"]}},"required":["input_path","step"]}},
    {"name":"pxp_derivative","description":"计算指定 PXP 光谱的一阶或二阶数值导数。","scopes":["dataset_fast_path"],"timeout_seconds":90,"parameters":{"type":"object","properties":{"input_path":{"type":"string"},"wave_path":{"type":["string","null"]},"wave_index":{"type":"integer","minimum":0,"default":0},"order":{"type":"integer","enum":[1,2],"default":1},"output_path":{"type":["string","null"]}},"required":["input_path"]}},
    {"name":"pxp_peak_detect","description":"检测指定 PXP 光谱的峰位置、强度、突出度和半峰宽。","scopes":["dataset_fast_path"],"timeout_seconds":90,"parameters":{"type":"object","properties":{"input_path":{"type":"string"},"wave_path":{"type":["string","null"]},"wave_index":{"type":"integer","minimum":0,"default":0},"prominence":{"type":["number","null"]},"min_distance":{"type":"integer","minimum":1,"default":3},"output_path":{"type":["string","null"]}},"required":["input_path"]}},
    {"name":"pxp_peak_fit","description":"对指定 PXP 光谱峰执行局部高斯拟合，输出中心、峰高、宽度和拟合优度。","scopes":["dataset_fast_path"],"timeout_seconds":120,"parameters":{"type":"object","properties":{"input_path":{"type":"string"},"wave_path":{"type":["string","null"]},"wave_index":{"type":"integer","minimum":0,"default":0},"prominence":{"type":["number","null"]},"max_peaks":{"type":"integer","minimum":1,"maximum":200,"default":50},"output_path":{"type":["string","null"]}},"required":["input_path"]}},
    {"name":"pxp_integrate_regions","description":"按用户给定坐标区间计算 PXP 光谱积分面积、峰值和有效点数。","scopes":["dataset_fast_path"],"timeout_seconds":90,"parameters":{"type":"object","properties":{"input_path":{"type":"string"},"wave_path":{"type":["string","null"]},"wave_index":{"type":"integer","minimum":0,"default":0},"regions":{"type":"array","minItems":1,"items":{"type":"array","minItems":2,"maxItems":2,"items":{"type":"number"}}},"output_path":{"type":["string","null"]}},"required":["input_path","regions"]}},
    {"name":"pxp_compare_waves","description":"对比 PXP 中多个 wave，在公共坐标范围重采样并计算相关性和差异统计。","scopes":["dataset_fast_path"],"timeout_seconds":120,"parameters":{"type":"object","properties":{"input_path":{"type":"string"},"wave_paths":{"type":"array","minItems":2,"maxItems":20,"items":{"type":"string"}},"output_path":{"type":["string","null"]}},"required":["input_path","wave_paths"]}},
    {"name":"pxp_visualize","description":"生成指定 PXP wave 的光谱曲线 PNG，可叠加检测峰位置。","scopes":["dataset_fast_path"],"timeout_seconds":120,"parameters":{"type":"object","properties":{"input_path":{"type":"string"},"wave_path":{"type":["string","null"]},"wave_index":{"type":"integer","minimum":0,"default":0},"show_peaks":{"type":"boolean","default":false},"output_path":{"type":"string"}},"required":["input_path","output_path"]}},
    {"name":"pxp_export_report","description":"生成 PXP 容器、wave 元数据、数值质量、统计量和峰候选的结构化报告。","scopes":["dataset_fast_path"],"timeout_seconds":120,"parameters":{"type":"object","properties":{"input_path":{"type":"string"},"wave_path":{"type":["string","null"]},"wave_index":{"type":"integer","minimum":0,"default":0},"output_path":{"type":["string","null"]}},"required":["input_path"]}},
    {"name":"pxp_extract_experiment_conditions","description":"提取 PXP 全局变量、字符串变量和 Wave Note 中的实验条件。","scopes":["dataset_fast_path"],"timeout_seconds":90,"parameters":{"type":"object","properties":{"input_path":{"type":"string"},"output_path":{"type":["string","null"]}},"required":["input_path"]}},
    {"name":"pxp_parse_wave_notes","description":"批量解析 Wave Note 中的键值对、单位和实验备注。","scopes":["dataset_fast_path"],"timeout_seconds":90,"parameters":{"type":"object","properties":{"input_path":{"type":"string"},"output_path":{"type":["string","null"]}},"required":["input_path"]}},
    {"name":"pxp_associate_waves","description":"根据目录、命名、形状和单位识别坐标、信号、背景、参考、拟合与误差 Wave 的关联。","scopes":["dataset_fast_path"],"timeout_seconds":90,"parameters":{"type":"object","properties":{"input_path":{"type":"string"},"output_path":{"type":["string","null"]}},"required":["input_path"]}},
    {"name":"pxp_batch_process","description":"对多个 PXP Wave 批量执行基线校正、平滑和归一化并导出处理清单。","scopes":["dataset_fast_path"],"timeout_seconds":120,"parameters":{"type":"object","properties":{"input_path":{"type":"string"},"wave_paths":{"type":"array","items":{"type":"string"}},"max_waves":{"type":"integer","minimum":1,"maximum":1000,"default":100},"baseline_correct":{"type":"boolean","default":false},"lambda":{"type":"number","minimum":1,"default":100000},"asymmetry":{"type":"number","exclusiveMinimum":0,"exclusiveMaximum":1,"default":0.01},"smooth_window":{"type":["integer","null"],"minimum":3},"polyorder":{"type":"integer","minimum":1,"default":3},"normalize":{"type":["string","null"],"enum":["max","area","zscore",null]},"output_dir":{"type":"string"}},"required":["input_path","output_dir"]}},
    {"name":"pxp_background_subtract","description":"对齐样品与背景 Wave 并按指定比例执行背景谱扣除。","scopes":["dataset_fast_path"],"timeout_seconds":120,"parameters":{"type":"object","properties":{"input_path":{"type":"string"},"sample_wave_path":{"type":"string"},"background_wave_path":{"type":"string"},"scale":{"type":"number","default":1},"output_path":{"type":["string","null"]}},"required":["input_path","sample_wave_path","background_wave_path"]}},
    {"name":"pxp_internal_standard_normalize","description":"根据独立内标 Wave 的指定峰区间对样品谱执行面积或峰高归一化。","scopes":["dataset_fast_path"],"timeout_seconds":120,"parameters":{"type":"object","properties":{"input_path":{"type":"string"},"wave_paths":{"type":"array","minItems":2,"maxItems":2,"items":{"type":"string"}},"standard_region":{"type":"array","minItems":2,"maxItems":2,"items":{"type":"number"}},"method":{"type":"string","enum":["area","height"],"default":"area"},"output_path":{"type":["string","null"]}},"required":["input_path","wave_paths","standard_region"]}},
    {"name":"pxp_multipeak_deconvolution","description":"使用高斯、洛伦兹或 Voigt 组合模型对重叠光谱峰进行解卷积。","scopes":["dataset_fast_path"],"timeout_seconds":120,"parameters":{"type":"object","properties":{"input_path":{"type":"string"},"wave_path":{"type":["string","null"]},"wave_index":{"type":"integer","minimum":0,"default":0},"model":{"type":"string","enum":["gaussian","lorentzian","voigt"],"default":"voigt"},"centers":{"type":"array","items":{"type":"number"}},"max_peaks":{"type":"integer","minimum":1,"maximum":20,"default":8},"prominence":{"type":["number","null"]},"output_path":{"type":["string","null"]}},"required":["input_path"]}},
    {"name":"pxp_peak_drift","description":"以参考 Wave 为基准分析多次测量的峰位漂移。","scopes":["dataset_fast_path"],"timeout_seconds":120,"parameters":{"type":"object","properties":{"input_path":{"type":"string"},"wave_paths":{"type":"array","minItems":2,"maxItems":50,"items":{"type":"string"}},"tolerance":{"type":"number","exclusiveMinimum":0},"prominence":{"type":["number","null"]},"output_path":{"type":["string","null"]}},"required":["input_path","wave_paths"]}},
    {"name":"pxp_peak_ratio","description":"计算多个指定峰区间的面积比或峰高比。","scopes":["dataset_fast_path"],"timeout_seconds":90,"parameters":{"type":"object","properties":{"input_path":{"type":"string"},"wave_path":{"type":["string","null"]},"wave_index":{"type":"integer","minimum":0,"default":0},"regions":{"type":"array","minItems":2,"items":{"type":"array","minItems":2,"maxItems":2,"items":{"type":"number"}}},"method":{"type":"string","enum":["area","height"],"default":"area"},"denominator_index":{"type":"integer","minimum":0,"default":1},"output_path":{"type":["string","null"]}},"required":["input_path","regions"]}},
    {"name":"pxp_replicate_statistics","description":"对齐重复实验 Wave 并计算均值、标准差和相对标准偏差。","scopes":["dataset_fast_path"],"timeout_seconds":120,"parameters":{"type":"object","properties":{"input_path":{"type":"string"},"wave_paths":{"type":"array","minItems":2,"maxItems":100,"items":{"type":"string"}},"output_path":{"type":["string","null"]}},"required":["input_path","wave_paths"]}},
    {"name":"pxp_spectral_quality","description":"评估光谱缺失、噪声、信噪比、饱和和尖峰并生成质量评分。","scopes":["dataset_fast_path"],"timeout_seconds":90,"parameters":{"type":"object","properties":{"input_path":{"type":"string"},"wave_path":{"type":["string","null"]},"wave_index":{"type":"integer","minimum":0,"default":0},"output_path":{"type":["string","null"]}},"required":["input_path"]}},
    {"name":"pxp_overlay_visualize","description":"生成多个 PXP Wave 的公共坐标轴叠加对比图。","scopes":["dataset_fast_path"],"timeout_seconds":120,"parameters":{"type":"object","properties":{"input_path":{"type":"string"},"wave_paths":{"type":"array","minItems":2,"maxItems":100,"items":{"type":"string"}},"title":{"type":["string","null"]},"output_path":{"type":"string"}},"required":["input_path","wave_paths","output_path"]}},
    {"name":"pxp_waterfall_heatmap","description":"将一组 PXP Wave 生成瀑布图或二维热图。","scopes":["dataset_fast_path"],"timeout_seconds":120,"parameters":{"type":"object","properties":{"input_path":{"type":"string"},"wave_paths":{"type":"array","minItems":2,"maxItems":200,"items":{"type":"string"}},"mode":{"type":"string","enum":["waterfall","heatmap"],"default":"waterfall"},"title":{"type":["string","null"]},"output_path":{"type":"string"}},"required":["input_path","wave_paths","output_path"]}},
    {"name":"pxp_before_after_visualize","description":"生成原始谱与基线校正、平滑、归一化各处理阶段的对比图。","scopes":["dataset_fast_path"],"timeout_seconds":120,"parameters":{"type":"object","properties":{"input_path":{"type":"string"},"wave_path":{"type":["string","null"]},"wave_index":{"type":"integer","minimum":0,"default":0},"baseline_correct":{"type":"boolean","default":true},"lambda":{"type":"number","minimum":1,"default":100000},"asymmetry":{"type":"number","exclusiveMinimum":0,"exclusiveMaximum":1,"default":0.01},"smooth_window":{"type":["integer","null"],"minimum":3},"polyorder":{"type":"integer","minimum":1,"default":3},"normalize":{"type":["string","null"],"enum":["max","area","zscore",null]},"title":{"type":["string","null"]},"output_path":{"type":"string"}},"required":["input_path","output_path"]}},
    {"name":"pxp_reproducible_package","description":"封装选定 Wave、实验元数据、处理参数、校验值和溯源清单为可复现实验包。","scopes":["dataset_fast_path"],"timeout_seconds":120,"parameters":{"type":"object","properties":{"input_path":{"type":"string"},"wave_path":{"type":["string","null"]},"wave_index":{"type":"integer","minimum":0,"default":0},"processing_parameters":{"type":"object"},"output_path":{"type":"string"}},"required":["input_path","output_path"]}}
  ]
}

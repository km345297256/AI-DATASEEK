# Pass this environment together with the private root .env to ./run.sh.
# All services use the same supported Compose file.
COMPOSE_PROJECT_NAME=datalab
STACK_PREFIX=datalab
FRONTEND_BIND_HOST=0.0.0.0
FRONTEND_PORT=10030
FRONTEND_IMAGE=datalab-frontend:latest
BACKEND_IMAGE=datalab-backend:latest
SANDBOX_IMAGE=datalab-sandbox:latest
JUPYTER_IMAGE=datalab-jupyter:latest
